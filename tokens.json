{
  "$description": "AI Reports design tokens, generated from styles.css. Use the custom properties, never raw values. Patterns: https://luisgonzalezbernal.com/reports/patterns.html · Rules: AGENTS.md in github.com/iamluisgb/reports",
  "color": {
    "dark": {
      "--bg": "#0c0f0e",
      "--bg-card": "#151a18",
      "--bg-card-hover": "#1d2321",
      "--code-bg": "#080b0a",
      "--primary": "#8fbf9a",
      "--primary-dim": "rgba(143, 191, 154, 0.12)",
      "--on-primary": "#0c0f0e",
      "--on-surface": "#e9eeeb",
      "--on-surface-variant": "#adb7b1",
      "--muted": "#88928d",
      "--border": "rgba(136, 146, 141, 0.25)",
      "--warn": "#d29922",
      "--shadow-pop": "0 24px 60px -20px rgba(0, 0, 0, 0.45)"
    },
    "light": {
      "--bg": "#f4f5f2",
      "--bg-card": "#ffffff",
      "--bg-card-hover": "#eaece7",
      "--code-bg": "#ecede9",
      "--primary": "#2f6b45",
      "--primary-dim": "rgba(47, 107, 69, 0.1)",
      "--on-primary": "#ffffff",
      "--on-surface": "#121714",
      "--on-surface-variant": "#424944",
      "--muted": "#5f6762",
      "--border": "rgba(18, 23, 20, 0.12)",
      "--warn": "#9a6700",
      "--shadow-pop": "0 24px 60px -20px rgba(20, 24, 30, 0.25)"
    }
  },
  "type": {
    "--f-display": "'Instrument Serif', 'DM Serif Display', Georgia, serif",
    "--f-body": "'Geist', 'Inter', -apple-system, 'Segoe UI', sans-serif",
    "--f-mono": "'Geist Mono', 'JetBrains Mono', ui-monospace, Menlo, monospace",
    "--fs-2xs": "11px",
    "--fs-xs": "12px",
    "--fs-sm": "13px",
    "--fs-base": "15px",
    "--fs-md": "17px",
    "--fs-lg": "22px",
    "--fs-xl": "28px",
    "--fs-2xl": "36px",
    "--fs-3xl": "46px",
    "--fs-display-sm": "clamp(38px, 6vw, 64px)",
    "--fs-display": "clamp(48px, 8.5vw, 80px)",
    "--fs-hero": "clamp(56px, 10vw, 104px)"
  },
  "shape": {
    "--r-sm": "4px",
    "--r-md": "8px",
    "--r-lg": "14px",
    "--r-pill": "999px"
  },
  "motion": {
    "--ease": "cubic-bezier(.2, .7, .2, 1)",
    "--ease-in": "cubic-bezier(.4, 0, .6, 1)",
    "--spring": "linear(0, .13 6%, .43 15%, .74 26%, .92 37%, 1.01 49%, 1.02 58%, 1.005 72%, 1)",
    "--dur-fast": ".15s",
    "--dur-base": ".25s",
    "--dur-slow": ".45s"
  },
  "layout": {
    "--measure": "720px",
    "--measure-wide": "780px",
    "--topbar-h": "54px"
  }
}
